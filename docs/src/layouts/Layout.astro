---
import { DocsLayout } from '@mrmartineau/zui-theme/astro'
import { Reactions } from 'astro-d1-reactions/components'
import Search from '../components/Search.tsx'
import SiteTheme from '../components/SiteTheme.astro'
import SiteThemeMenu from '../components/SiteThemeMenu.astro'
import { footerSections, sidebarSections } from '../nav'
import { site } from '../site.config'
import '../styles/reactions-zui.css'

interface Props {
  title?: string
  description?: string
}

// @ts-expect-error ignore
const { title, description } = (Astro.props.frontmatter ?? Astro.props) as Props
const currentPath = Astro.url.pathname
---

<DocsLayout
  title={title}
  description={description}
  currentPath={currentPath}
  site={site}
  sections={sidebarSections}
  footerSections={footerSections}
>
  <Fragment slot="head">
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Geist+Mono:wght@100..900&display=swap" rel="stylesheet">
    <SiteTheme />
  </Fragment>
  <Search slot="search" client:only="react" />
  <SiteThemeMenu slot="theme-menu" />
  <slot />
  <Fragment slot="body-end">
    <Reactions />
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "88182718a8c6437783661af812d8c2fc"}'></script>
  </Fragment>
</DocsLayout>

<style is:global>
  ::selection {
    color: var(--color-background);
    background-color: var(--color-text);
  }
</style>
