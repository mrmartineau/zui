---
export const prerender = false

import { env } from 'cloudflare:workers'
import { Button, Input } from '@mrmartineau/zui/astro'
import { resolveConfig, searchIndex } from 'astro-d1-search/core'
import searchConfig from '../../search.config'
import Layout from '../layouts/Layout.astro'
import {
  MAX_QUERY_LENGTH,
  rankResults,
  splitSnippet,
  toPath,
  typeLabels,
} from '../lib/search'
import '../styles/search.css'

const PAGE_SIZE = 10
// Same ceiling as the /api/search endpoint (maxOffset 200): MAX_PAGE * PAGE_SIZE rows.
const MAX_PAGE = 20

const params = Astro.url.searchParams
const query = params.get('q')?.trim().slice(0, MAX_QUERY_LENGTH) ?? ''
const page = Math.min(
  MAX_PAGE,
  Math.max(1, Math.trunc(Number(params.get('page'))) || 1),
)

// Rank the whole bounded set, then cut it into pages. Ranking one page at a time would
// leave a component whose name matches on a later page behind worse bm25 hits.
// Pass the resolved config or the page silently uses the default ranking.
const ranked =
  query.length >= 2
    ? rankResults(
        await searchIndex(
          env.SEARCH_DB,
          { limit: MAX_PAGE * PAGE_SIZE, query },
          resolveConfig(searchConfig),
        ),
        query,
      )
    : []
const results = ranked.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)
// ranked never has more than MAX_PAGE * PAGE_SIZE rows, so this is false on the last page.
const hasNext = ranked.length > page * PAGE_SIZE

const pageHref = (n: number) =>
  `/search?q=${encodeURIComponent(query)}${n > 1 ? `&page=${n}` : ''}`
---

<Layout title="Search" description="Search components, tokens, utilities and guides.">
  <form action="/search" method="get" role="search" class="flex gap-xs search-form">
    <Input
      type="search"
      name="q"
      value={query}
      placeholder="Search the docs…"
      aria-label="Search the docs"
      class="flex-auto"
      autofocus={!query}
    />
    <Button type="submit"><i class="ph ph-magnifying-glass"></i> Search</Button>
  </form>

  {
    query.length < 2 ? (
      <p>Type at least 2 characters to search.</p>
    ) : results.length === 0 ? (
      <p>{page > 1 ? 'No more results' : 'No results'} for “{query}”.</p>
    ) : (
      <>
        <ol class="stack search-hits">
          {results.map((result) => (
            <li class="search-hit">
              <a class="zui-link" href={toPath(result.url)}>
                {result.title}
              </a>
              <span class="zui-badge zui-badge-variant-outline">
                {typeLabels[result.type] ?? result.type}
              </span>
              <p>
                {splitSnippet(result.snippet).map((part) =>
                  part.hit ? <mark>{part.text}</mark> : part.text,
                )}
              </p>
            </li>
          ))}
        </ol>
        <nav class="flex gap-xs" aria-label="Search pages">
          {page > 1 && (
            <Button variant="outline" href={pageHref(page - 1)}>
              <i class="ph ph-arrow-left"></i> Previous
            </Button>
          )}
          {hasNext && (
            <Button variant="outline" href={pageHref(page + 1)}>
              Next <i class="ph ph-arrow-right"></i>
            </Button>
          )}
        </nav>
      </>
    )
  }
</Layout>

<style>
  .search-form {
    margin-block-end: var(--space-md);
  }

  .search-hits {
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;
  }

  .search-hit {
    padding-block: var(--space-xs);
    border-bottom: 1px solid var(--color-border);
  }

  .search-hit > a {
    margin-inline-end: var(--space-2xs);
    font-weight: var(--font-weight-bold);
  }

  .search-hit > p {
    margin: var(--space-3xs) 0 0;
    color: oklch(from var(--color-text) l c h / 70%);
  }
</style>
