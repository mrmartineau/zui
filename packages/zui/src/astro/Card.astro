---
import type { HTMLAttributes } from 'astro/types'
import type { VariantProps } from 'cva'
import { cardVariants } from '../shared/cardVariants'

type CardVariantProps = VariantProps<typeof cardVariants>

interface Props extends HTMLAttributes<'div'>, CardVariantProps {
  href?: string
  class?: string
}

const { href, class: className, shape, ...props } = Astro.props
const classes = cardVariants({
  class: [href && 'zui-card-interactive', className].filter(Boolean).join(' '),
  shape,
})
---

{
  href ? (
    <a class={classes} href={href} {...props}>
      <slot />
    </a>
  ) : (
    <div class={classes} {...props}>
      <slot />
    </div>
  )
}
