---
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'input'>, 'type' | 'role'> {
  class?: string
}

const { class: className, ...props } = Astro.props
const classes = ['zui-switch', className].filter(Boolean).join(' ')
---

<label class={classes}>
  <!-- Astro writes repeated attributes in order, and a browser keeps the first.
     So the fixed type and role go before the spread, not after. -->
<input type="checkbox" role="switch" {...props} />
  <slot />
</label>
