---
import type { HTMLAttributes } from 'astro/types'
import type { VariantProps } from 'cva'
import { textareaVariants } from '../shared/textareaVariants'

type TextareaVariantProps = VariantProps<typeof textareaVariants>

interface Props extends HTMLAttributes<'textarea'>, TextareaVariantProps {
  class?: string
}

const { class: className, shape, ...props } = Astro.props
const classes = textareaVariants({ class: className, shape })
---

<textarea class={classes} {...props}><slot /></textarea>
