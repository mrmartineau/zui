---
import type { HTMLAttributes } from 'astro/types'
import type { VariantProps } from 'cva'
import { kbdVariants } from '../shared/kbdVariants'

type KbdVariantProps = VariantProps<typeof kbdVariants>

interface Props extends HTMLAttributes<'kbd'>, KbdVariantProps {
  class?: string
}

const { class: className, shape, ...props } = Astro.props
const classes = kbdVariants({ class: className, shape })
---

<kbd class={classes} {...props}><slot /></kbd>
