---
import type { HTMLAttributes } from 'astro/types'
import type { VariantProps } from 'cva'
import { inputVariants } from '../shared/inputVariants'
import { passwordInputToggleClass } from '../shared/passwordInput'

type InputVariantProps = VariantProps<typeof inputVariants>

interface Props
  extends Omit<HTMLAttributes<'input'>, 'type'>,
    InputVariantProps {
  class?: string
  toggleLabel?: string
}

const {
  class: className,
  shape,
  toggleLabel = 'Show password',
  ...props
} = Astro.props
const classes = ['zui-password-input', className].filter(Boolean).join(' ')
---

<div class={classes}>
  <input class={inputVariants({ shape })} type="password" {...props} />
  <button
    type="button"
    class={passwordInputToggleClass}
    aria-label={toggleLabel}
    aria-pressed="false"
    disabled={props.disabled}
    data-zui-password-toggle
  >
    <i class="ph ph-eye zui-password-input-show" aria-hidden="true"></i>
    <i class="ph ph-eye-slash zui-password-input-hide" aria-hidden="true"></i>
  </button>
</div>

<script>
  import { togglePasswordInput } from '../shared/passwordInput'

  // one delegated listener covers every instance, including ones added later
  document.addEventListener('click', (event) => {
    const button = (event.target as Element).closest?.<HTMLButtonElement>(
      '[data-zui-password-toggle]',
    )
    if (button) togglePasswordInput(button)
  })
</script>
