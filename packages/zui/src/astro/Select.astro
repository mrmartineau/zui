---
import type { HTMLAttributes } from 'astro/types'
import type { VariantProps } from 'cva'
import { selectVariants } from '../shared/selectVariants'

type SelectVariantProps = VariantProps<typeof selectVariants>

interface Props extends HTMLAttributes<'select'>, SelectVariantProps {
  class?: string
}

const { class: className, shape, ...props } = Astro.props
const classes = selectVariants({ class: className, shape })
---

<select class={classes} {...props}><slot /></select>
