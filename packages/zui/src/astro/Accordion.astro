---
import type { HTMLAttributes } from 'astro/types'
import type { VariantProps } from 'cva'
import { accordionVariants } from '../shared/accordionVariants'

type AccordionVariantProps = VariantProps<typeof accordionVariants>

interface Props extends HTMLAttributes<'div'>, AccordionVariantProps {
  class?: string
}

const { class: className, flush, shape, ...props } = Astro.props
const classes = accordionVariants({ class: className, flush, shape })
---

<div class={classes} {...props}>
  <slot />
</div>
